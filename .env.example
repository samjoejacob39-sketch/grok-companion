# Copy to .env and fill in what you want seeded on first boot.
# Keys can also be entered in the dashboard at any time (stored server-side only).

# Dashboard owner password (min 8 chars). If unset, first dashboard login sets it.
ADMIN_PASSWORD=

# xAI Grok API key (https://console.x.ai → API Keys). Optional: set later in dashboard.
XAI_API_KEY=

# Discord bot token (Developer Portal → Application → Bot). Optional: set later in dashboard.
DISCORD_BOT_TOKEN=

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Put the app behind a reverse proxy (nginx/caddy) and set this:
# TRUST_PROXY=true
